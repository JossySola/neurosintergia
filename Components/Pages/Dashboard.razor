@page "/Dashboard"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using neurosintergia.Components.Layout.Tables
@using neurosintergia.Data
@using neurosintergia.Data.Models
@using neurosintergia.Services

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject DashboardAuthViewsServices AuthViewsService

@attribute [Authorize]

<PageTitle>Dashboard</PageTitle>

<AuthorizeView Roles="SuperAdmin">
    @if (PendingRequests is null)
    {
        <p>Loading requests...</p>
    }
    else
    {
        <CascadingValue Value="@User">
            <PendingSignUpsTable Requests=@PendingRequests />
            <DeclinedSignUpsTable Requests=@DeclinedRequests />
        </CascadingValue>
    }
</AuthorizeView>

<AuthorizeView Roles="Medico">
    @if (User is null)
    {
        <p>Checking your account status...</p>
    }
    @if (UserSignUpStatus is not null && UserSignUpStatus.ToUpper() == "Declined".ToUpper())
    {
        
    }
    </AuthorizeView>

@code
{
    private AuthenticationState? AuthState { get; set; }
    private ApplicationUser? User { get; set; }

    private List<PendingSignUpRow>? PendingRequests { get; set; }
    private List<PendingSignUpRow>? DeclinedRequests { get; set; }

    private string? UserSignUpStatus { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Get current signed in user
        AuthState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        User = await UserManager.GetUserAsync(AuthState.User);

        // For SuperAdmin AuthorizeView
        PendingRequests = await AuthViewsService.GetRequestsByStatus("Pending");
        DeclinedRequests = await AuthViewsService.GetRequestsByStatus("Declined");

        // For Doctor AuthorizeView
        if (User is not null) UserSignUpStatus = await AuthViewsService.GetUserStatus(User.Id);

    }
}