@page "/Dashboard"

@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using neurosintergia.Components.Layout.Forms
@using neurosintergia.Components.Layout.Tables
@using neurosintergia.Components.Account.Shared
@using neurosintergia.Data
@using neurosintergia.Data.Models
@using neurosintergia.Services

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject DashboardAuthViewsServices AuthViewsService
@inject ILogger<Dashboard> Logger

@attribute [Authorize]

<PageTitle>Dashboard</PageTitle>
<StatusMessage Message="@dashboardError" />

<AuthorizeView Roles="SuperAdmin">
    @if (dashboardError is not null)
    {
        <p>Could not load dashboard data. Please try again later.</p>
    }
    else if (PendingRequests is null)
    {
        <p>Loading requests...</p>
    }
    else
    {
        <PendingSignUpsTable Requests=@PendingRequests AdminId="@User?.Id" />
        <DeclinedSignUpsTable Requests=@DeclinedRequests AdminId="@User?.Id" />
        <ApprovedSignUpsTable Requests=@ApprovedRequests />
    }
</AuthorizeView>

<AuthorizeView Roles="Medico">
    @if (dashboardError is not null)
    {
        <p>Could not load your account status. Please try again later.</p>
    }
    else if (User is null || UserSignUpStatus is null)
    {
        <p>Checking your account status...</p>
    }
    else
    {
        if (UserSignUpStatus.ToUpper() == "DECLINED")
        {
            <DeclinedDoctorForm />
        } else if (UserSignUpStatus.ToUpper() == "PENDING")
        {
            <p>Tu información está siendo revisada por un administrador y una vez autorizado tu registro, recibirás un email de confirmación.</p>
        } else
        {
            <p>Doctor's dashboard</p>
        }
    }
</AuthorizeView>

@code
{
    private AuthenticationState? AuthState { get; set; }
    private ApplicationUser? User { get; set; }

    private List<PendingSignUpRow>? PendingRequests { get; set; }
    private List<PendingSignUpRow>? DeclinedRequests { get; set; }
    private List<PendingSignUpRow>? ApprovedRequests { get; set; }
    private string? UserSignUpStatus { get; set; }
    private string? dashboardError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Get current signed in user
            AuthState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            User = await UserManager.GetUserAsync(AuthState.User);

            // For SuperAdmin AuthorizeView
            PendingRequests = await AuthViewsService.GetRequestsByStatus("Pending");
            DeclinedRequests = await AuthViewsService.GetRequestsByStatus("Declined");
            ApprovedRequests = await AuthViewsService.GetRequestsByStatus("Approved");
            // For Doctor AuthorizeView
            if (User is not null) UserSignUpStatus = await AuthViewsService.GetUserStatus(User.Id);
        }
        catch (Exception error)
        {
            Logger.LogError(error, "Failed to load dashboard data");
            dashboardError = "Dashboard data could not be loaded.";
        }
    }
}
