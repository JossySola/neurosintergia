@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using neurosintergia.Components.Account.Shared
@using neurosintergia.Data
@using neurosintergia.Data.Models
@using neurosintergia.Services

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject ILogger<SignUpApprovalForm> Logger
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject EmailSender Sender

<StatusMessage Message="@message" />
<EditForm Model="SignUpApprovalModel" FormName="signup-approval" OnValidSubmit="OnValidSubmitAsync" method="post">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" role="alert" />
    
    <fieldset>
        <h3>Medication groups enabled:</h3>
        <label>
            Group I
            <InputCheckbox @bind-Value="SignUpApprovalModel.Grupo_I" />
        </label>
        <label>
            Group II
            <InputCheckbox @bind-Value="SignUpApprovalModel.Grupo_II" />
        </label>
        <label>
            Group III
            <InputCheckbox @bind-Value="SignUpApprovalModel.Grupo_III" />
        </label>
        <label>
            Group IV
            <InputCheckbox @bind-Value="SignUpApprovalModel.Grupo_IV" />
        </label>
        <label>
            Group V
            <InputCheckbox @bind-Value="SignUpApprovalModel.Grupo_V" />
        </label>
        <label>
            Group VI
            <InputCheckbox @bind-Value="SignUpApprovalModel.Grupo_VI" />
        </label>
    </fieldset>
    <div class="form-floating mb-3">
        <InputText @bind-Value="SignUpApprovalModel.Code" id="Input.TwoFactorCode" class="form-control" autocomplete="off" />
        <label for="Input.TwoFactorCode" class="form-label">Authenticator code</label>
        <ValidationMessage For="() => SignUpApprovalModel.Code" class="text-danger" />
    </div>
    <div>
        <button type="submit" class="w-100 btn btn-lg btn-primary">Approve</button>
    </div>
</EditForm>

@code 
{
    [Parameter]
    public required string DoctorId { get; set; }
    [Parameter]
    public required string Email { get; set; }
    private SignUpApproval SignUpApprovalModel { get; set; } = default!;
    private ApplicationUser? user = default!;
    private string? AdminId { get; set; }
    private string? message;
    protected override async Task OnInitializedAsync()
    {
        SignUpApprovalModel ??= new ();
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        user = await UserManager.GetUserAsync(authState.User);
        if (user is not null) AdminId = user.Id;
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null) return;

        var authenticatorCode = SignUpApprovalModel.Code
        .Replace("", string.Empty)
        .Replace("-", string.Empty);

        var isValid = await UserManager.VerifyTwoFactorTokenAsync(
            user, 
            UserManager.Options.Tokens.AuthenticatorTokenProvider, 
            SignUpApprovalModel.Code
        );

        if (!isValid)
        {
            Logger.LogWarning("Invalid Authentication Code");
            message = "Invalid Authentication Code";
            // Show a validation error; do not approve.
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            
            // Entity
            var request = await db.SignUpRequests.SingleOrDefaultAsync(r => r.Id == DoctorId);
            
            // Alter column and change status from 'pending' to 'approved'
            if (request is null)
            {
                message = "Sign up request not found";
                return;
            }
            request.Status = "approved";
            request.ReviewedBy = AdminId;
            request.LastReviewed = DateTime.UtcNow;

            // Creates a record in Medicos_Funciones table
            var funciones = new Medicos_Funciones
            {
            Id = Guid.CreateVersion7().ToString(),
            MedicoId = DoctorId,
            Grupo_I = SignUpApprovalModel.Grupo_I,
            Grupo_II = SignUpApprovalModel.Grupo_II,
            Grupo_III = SignUpApprovalModel.Grupo_III,
            Grupo_IV = SignUpApprovalModel.Grupo_IV,
            Grupo_V = SignUpApprovalModel.Grupo_V,
            Grupo_VI = SignUpApprovalModel.Grupo_VI  
            };
            db.Medicos_Funciones.Add(funciones);
            await db.SaveChangesAsync();
            await Sender.SendApprovedSignUpConfirmation(Email);
        }
        catch(Exception error)
        {
            message = error.ToString();
        }
    }

    private sealed class SignUpApproval
    {
        [Required]
        [StringLength(7, ErrorMessage = "The {0} must be at least {2} and at max {1} characters long.", MinimumLength = 6)]
        [DataType(DataType.Text)]
        [Display(Name = "Authenticator code")]
        public string Code { get; set; } = "";
        public bool Grupo_I { get; set; } = false;
        public bool Grupo_II { get; set; } = false;
        public bool Grupo_III { get; set; } = false;
        public bool Grupo_IV { get; set; } = false; 
        public bool Grupo_V { get; set; } = false;
        public bool Grupo_VI { get; set; } = false;
    }
}