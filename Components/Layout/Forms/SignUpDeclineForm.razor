@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using neurosintergia.Components.Account.Shared
@using neurosintergia.Services

@inject EmailSender Sender
@inject SignUpRequestsServices SignUpService
@inject ILogger<SignUpDeclineForm> Logger

@if (SignUpDenialModel is not null)
{
    <StatusMessage Message="@message" />
    <EditForm Model="SignUpDenialModel" OnValidSubmit="OnValidSubmitAsync" FormName="signup-denial">
        <DataAnnotationsValidator />
        <label>
            Reason for denial:
            <InputSelect @bind-Value="SignUpDenialModel.Reason">
                <option checked="@(SignUpDenialModel.Reason == "")" value="">
                    Selected an option
                </option>
                <option checked="@(SignUpDenialModel.Reason == "Credenciales invalidas")" value="Credenciales invalidas">
                    Credenciales invalidas
                </option>
                <option checked="@(SignUpDenialModel.Reason == "Credenciales incompletas")" value="Credenciales incompletas">
                    Credenciales incompletas
                </option>
                <option checked="@(SignUpDenialModel.Reason == "Datos personales invalidos")" value="Datos personales invalidos">
                    Datos personales invalidos
                </option>
                <option checked="@(SignUpDenialModel.Reason == "Datos personales incompletos")" value="Datos personales incompletos">
                    Datos personales incompletos
                </option>
                <option checked="@(SignUpDenialModel.Reason == "Datos de contacto incompletos")" value="Datos de contacto incompletos">
                    Datos de contacto incompletos
                </option>
            </InputSelect>
        </label>
        <ValidationMessage For="@(() => SignUpDenialModel.Reason)" />
        <label>
            Specific malformed input:
            <InputSelect @bind-Value="SignUpDenialModel.InvalidInput">
                <option checked="@(SignUpDenialModel.InvalidInput == "")" value="">
                    Select an option
                </option>
                <option checked="@(SignUpDenialModel.InvalidInput == "Nombre")" value="Nombre">
                    Nombre
                </option>
                <option checked="@(SignUpDenialModel.InvalidInput == "CURP")" value="CURP">
                    CURP
                </option>
                <option checked="@(SignUpDenialModel.InvalidInput == "Lugar de nacimiento")" value="Lugar de nacimiento">
                    Lugar de nacimiento
                </option>
                <option checked="@(SignUpDenialModel.InvalidInput == "Fecha de nacimiento")" value="Fecha de nacimiento">
                    Fecha de nacimiento
                </option>
                <option checked="@(SignUpDenialModel.InvalidInput == "Instituto académico")" value="Instituto académico">
                    Instituto académico
                </option>
                <option checked="@(SignUpDenialModel.InvalidInput == "Título académico")" value="Título académico">
                    Título académico
                </option>
                <option checked="@(SignUpDenialModel.InvalidInput == "Cédula Profesional")" value="Cédula Profesional">
                    Cédula Profesional
                </option>
                <option checked="@(SignUpDenialModel.InvalidInput == "Cédula de Especialidad")" value="Cédula de Especialidad">
                    Cédula de Especialidad
                </option>
                <option checked="@(SignUpDenialModel.InvalidInput == "Número SSA")" value="Número SSA">
                    Número SSA
                </option>
            </InputSelect>
        </label>
        <ValidationMessage For="@(() => SignUpDenialModel.InvalidInput)" />
        <label>
            Comments:
            <InputTextArea @bind-Value="SignUpDenialModel.Comment" />
        </label>
        <button type="submit">Decline</button>
    </EditForm> 
}
else
{
    <p>Loading...</p>
}

@code 
{
    [Parameter]
    public required string DoctorId { get; set; }

    [Parameter]
    public required string Email { get; set; }

    [Parameter]
    public string? AdminId { get; set; }

    private string message = "";
    private SignUpDenial? SignUpDenialModel { get; set; } = default!;
    protected override async Task OnInitializedAsync()
    {
        SignUpDenialModel ??= new();
    }
    private async Task OnValidSubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(AdminId))
        {
            Logger.LogError("Could not identify the administrator while declining doctor {DoctorId}", DoctorId);
            message = "The signed-in administrator could not be identified.";
            return;
        }

        try
        {
            await SignUpService.UpdateStatus("Declined", DoctorId, AdminId, SignUpDenialModel!.Comment);
        }
        catch (Exception error)
        {
            Logger.LogError(error, "Failed to save decline for doctor {DoctorId}", DoctorId);
            message = "The decline could not be saved. Check the application logs for details.";
            return;
        }

        try
        {
            var emailIsSent = await Sender.SendDeniedSignUpEmail(
                Email,
                SignUpDenialModel!.Reason,
                SignUpDenialModel!.InvalidInput);

            if (!emailIsSent.Success)
            {
                Logger.LogError("Doctor {DoctorId} was declined, but the notification email was not sent", DoctorId);
                message = "The request was declined, but the notification email could not be sent.";
                return;
            }

            message = "Signup request declined.";
        }
        catch (Exception error)
        {
            Logger.LogError(error, "Doctor {DoctorId} was declined, but sending the notification email failed", DoctorId);
            message = "The request was declined, but the notification email could not be sent.";
        }
    }
    private sealed class SignUpDenial
    {
        [Required(ErrorMessage = "Select a reason for denial.")]
        public string Reason { get; set; } = "";
        [Required(ErrorMessage = "Select the malformed input.")]
        public string InvalidInput { get; set; } = "";
        public string Comment { get; set; } = "";
    }
}
