@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using neurosintergia.Components.Account.Shared
@using neurosintergia.Data
@using neurosintergia.Services

@inject UserManager<ApplicationUser> UserManager
@inject ILogger<SignUpApprovalForm> Logger
@inject EmailSender Sender
@inject SignUpRequestsServices SignUpService

@if (SignUpApprovalModel is not null)
{
    <StatusMessage Message="@message" />
    <EditForm Model="SignUpApprovalModel" FormName="signup-approval" OnValidSubmit="OnValidSubmitAsync" method="post">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" role="alert" />
        
        <fieldset>
            <h3>Medication groups enabled:</h3>
            <label>
                Group I
                <InputCheckbox @bind-Value="SignUpApprovalModel.Grupo_I" />
            </label>
            <label>
                Group II
                <InputCheckbox @bind-Value="SignUpApprovalModel.Grupo_II" />
            </label>
            <label>
                Group III
                <InputCheckbox @bind-Value="SignUpApprovalModel.Grupo_III" />
            </label>
            <label>
                Group IV
                <InputCheckbox @bind-Value="SignUpApprovalModel.Grupo_IV" />
            </label>
            <label>
                Group V
                <InputCheckbox @bind-Value="SignUpApprovalModel.Grupo_V" />
            </label>
            <label>
                Group VI
                <InputCheckbox @bind-Value="SignUpApprovalModel.Grupo_VI" />
            </label>
        </fieldset>
        <div class="form-floating mb-3">
            <InputText @bind-Value="SignUpApprovalModel.Code" id="Input.TwoFactorCode" class="form-control" autocomplete="off" />
            <label for="Input.TwoFactorCode" class="form-label">Authenticator code</label>
            <ValidationMessage For="() => SignUpApprovalModel.Code" class="text-danger" />
        </div>
        <div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Approve</button>
        </div>
    </EditForm>
} 
else
{
  <p>Loading...</p>
}

@code 
{
    [Parameter]
    public required string DoctorId { get; set; }

    [Parameter]
    public required string Email { get; set; }

    [Parameter]
    public string? AdminId { get; set; }

    private SignUpApproval SignUpApprovalModel { get; set; } = default!;
    private string? message;
    protected override async Task OnInitializedAsync()
    {
        SignUpApprovalModel ??= new ();
    }

    private async Task OnValidSubmitAsync()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(AdminId))
            {
                throw new InvalidOperationException("The signed-in administrator could not be identified.");
            }

            // Load the admin only on submission. The table creates multiple hidden
            // dialogs, so loading a user in every dialog can overlap Identity's DbContext.
            var admin = await UserManager.FindByIdAsync(AdminId);
            if (admin is null)
            {
                throw new InvalidOperationException("The signed-in administrator could not be found.");
            }

            var authenticatorCode = SignUpApprovalModel.Code
                .Replace(" ", string.Empty)
                .Replace("-", string.Empty);

            var isValid = await UserManager.VerifyTwoFactorTokenAsync(
                admin, 
                UserManager.Options.Tokens.AuthenticatorTokenProvider, 
                authenticatorCode
            );

            // Validate Authenticator code
            if (!isValid)
            {
                Logger.LogWarning("Invalid authenticator code provided by admin {AdminId}", admin.Id);
                message = "The authenticator code is invalid.";
                return;
            }

            await SignUpService.ApproveRequest(
                DoctorId,
                admin.Id,
                SignUpApprovalModel.Grupo_I,
                SignUpApprovalModel.Grupo_II,
                SignUpApprovalModel.Grupo_III,
                SignUpApprovalModel.Grupo_IV,
                SignUpApprovalModel.Grupo_V,
                SignUpApprovalModel.Grupo_VI
            );
        }
        catch (Exception error)
        {
            Logger.LogError(error, "Failed to approve signup request for doctor {DoctorId}", DoctorId);
            message = "Approval could not be saved. Check the application logs for details.";
            return;
        }

        try
        {
            var emailIsSent = await Sender.SendApprovedSignUpConfirmation(Email);
            if (!emailIsSent.Success)
            {
                Logger.LogError("Doctor {DoctorId} was approved, but the confirmation email was not sent", DoctorId);
                message = "The doctor was approved, but the confirmation email could not be sent.";
                return;
            }

            message = "Signup request approved.";
        }
        catch (Exception error)
        {
            Logger.LogError(error, "Doctor {DoctorId} was approved, but sending the confirmation email failed", DoctorId);
            message = "The doctor was approved, but the confirmation email could not be sent.";
        }
    }

    private sealed class SignUpApproval
    {
        [Required]
        [StringLength(7, ErrorMessage = "The {0} must be at least {2} and at max {1} characters long.", MinimumLength = 6)]
        [DataType(DataType.Text)]
        [Display(Name = "Authenticator code")]
        public string Code { get; set; } = "";
        public bool Grupo_I { get; set; } = false;
        public bool Grupo_II { get; set; } = false;
        public bool Grupo_III { get; set; } = false;
        public bool Grupo_IV { get; set; } = false; 
        public bool Grupo_V { get; set; } = false;
        public bool Grupo_VI { get; set; } = false;
    }
}
