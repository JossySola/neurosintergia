@using neurosintergia.Components.Layout.Forms
@rendermode InteractiveServer

<button commandfor="@ModalId" command="show-modal">@Action</button>
<dialog id="@ModalId">
    @if (Action.Length > 0)
    {
        if (Action.ToUpper() == "APPROVE")
        {
            <SignUpApprovalForm DoctorId="@DoctorId" Email="@Email" AdminId="@AdminId" />
        }
        else
        {
            <SignUpDeclineForm DoctorId="@DoctorId" Email="@Email" AdminId="@AdminId" />
        }
    }
    <button commandfor="@ModalId" command="close">Close</button>
</dialog>

@code 
{
    [Parameter]
    public required Guid ModalId { get; set; } 
    [Parameter]
    public required string Action { get; set; }
    [Parameter]
    public required string DoctorId { get; set; }
    [Parameter]
    public required string Email { get; set; }
    [Parameter]
    public string? AdminId { get; set; }
}
