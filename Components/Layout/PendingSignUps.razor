@rendermode InteractiveServer

@using neurosintergia.Data.Models

<section>
    <table>
        <caption>Pending doctor sign up requests</caption>
        <thead>
            <tr>
                <th scope="col" rowspan="2">Name</th>
                <th scope="col" rowspan="2">Status</th>
                <th scope="col" colspan="3">Academic intel</th>
                <th scope="col" rowspan="2">Sign Up Date</th>
            </tr>
            <tr>
                <th scope="col">Institute</th>
                <th scope="col">Ced. Prof.</th>
                <th scope="col">Ced. Esp.</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var Request in Requests)
        {
            <tr>
                <th scope="row">Request.Name</th>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td><time datetime="@Request.Created_At">@Request.Created_At</time></td>
            </tr>
        }
        </tbody>
    </table>
</section>

@code 
{
    [Parameter]
    public List<PendingSignUpRow> Requests {get; set;} = new();
    
}