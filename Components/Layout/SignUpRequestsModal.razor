@rendermode InteractiveServer

<button commandfor="@ModalId" command="show-modal">@Action</button>
<dialog id="@ModalId">
    @if (Action.Length > 0)
    {
        if (Action.ToUpper() == "APPROVE")
        {
            <SignUpApprovalForm />
        }
        else
        {
            <form>
                <button type="submit" formmethod="dialog">Decline</button>
            </form>
        }
    }
    <button commandfor="@ModalId" command="close">Close</button>
</dialog>

